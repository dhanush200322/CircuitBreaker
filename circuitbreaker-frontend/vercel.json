{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/gateway/:path*",
      "destination": "https://circuitbreaker-1.onrender.com/:path*"
    },
    {
      "source": "/eureka-api/:path*",
      "destination": "https://circuitbreaker-1.onrender.com/eureka/:path*"
    },
    {
      "source": "/zipkin",
      "destination": "https://circuitbreaker-1.onrender.com/zipkin/"
    },
    {
      "source": "/zipkin/",
      "destination": "https://circuitbreaker-1.onrender.com/zipkin/"
    },
    {
      "source": "/zipkin/:path+",
      "destination": "https://circuitbreaker-1.onrender.com/zipkin/:path+"
    }
  ]
}

